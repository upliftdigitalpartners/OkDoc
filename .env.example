# Canonical site origin, used for SEO (sitemap, robots, canonical, OG URLs).
# Optional: on Vercel it falls back to the deployment URL automatically.
SITE_URL=

# Supabase (server-side only — service role key must never reach the client).
# Leave both empty (or omit .env entirely) to run in mock mode: the app serves
# fixture data with a "demo data" banner and the full UI works with zero config.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
